<!-- Master PIN Settings Modal -->
<div id="settings-modal" 
     data-controller="modal" 
     class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm transition-all duration-200"
     data-action="click->modal#closeOnBackdrop keydown.esc@window->modal#closeOnEsc">
  
  <div data-modal-target="content" 
       class="w-full max-w-sm bg-neutral-900 border border-neutral-800 rounded-2xl p-6 shadow-2xl relative text-left">
    
    <button type="button" 
            data-action="click->modal#close" 
            class="absolute top-4 right-4 p-2 text-neutral-400 hover:text-white rounded-lg bg-neutral-800/60 hover:bg-neutral-800 transition">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="flex items-center gap-3 mb-4">
      <div class="w-9 h-9 rounded-xl bg-neutral-800 flex items-center justify-center text-neutral-300 border border-neutral-700">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <div>
        <h3 class="text-sm font-bold text-white">Vault Security</h3>
        <p class="text-xs text-neutral-400">Master Passcode / PIN</p>
      </div>
    </div>

    <%= form_with url: set_passcode_path, method: :post, class: "space-y-3" do |f| %>
      <% if AppSetting.passcode_set? %>
        <div>
          <label class="block text-xs font-semibold text-neutral-300 mb-1">Current PIN / Passcode</label>
          <%= f.password_field :current_pin, required: true, class: "w-full px-3 py-2 rounded-xl bg-neutral-800 border border-neutral-700 text-xs text-white outline-none focus:border-neutral-500 transition" %>
        </div>
      <% end %>

      <div>
        <label class="block text-xs font-semibold text-neutral-300 mb-1">New PIN / Passcode (min 4 characters)</label>
        <%= f.password_field :new_pin, required: true, minlength: 4, class: "w-full px-3 py-2 rounded-xl bg-neutral-800 border border-neutral-700 text-xs text-white outline-none focus:border-neutral-500 transition" %>
      </div>

      <div class="pt-2">
        <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs transition">
          Update PIN
        </button>
      </div>
    <% end %>
  </div>
</div>
