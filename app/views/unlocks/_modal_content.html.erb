<% is_first_time = local_assigns[:first_time] || !AppSetting.passcode_set? %>
<% error_msg = local_assigns[:error] %>

<div id="unlock_modal_content" class="p-6 text-center" data-controller="pin-pad" data-pin-pad-auto-submit-length-value="4">
  <!-- Clean Vault Icon -->
  <div class="mx-auto w-11 h-11 rounded-xl bg-neutral-800 border border-neutral-700 flex items-center justify-center text-neutral-200 mb-3">
    <% if is_first_time %>
      <svg class="w-5 h-5 text-neutral-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
      </svg>
    <% else %>
      <svg class="w-5 h-5 text-neutral-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 11V7a4 4 0 118 0m-4 8v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2z" />
      </svg>
    <% end %>
  </div>

  <h3 class="text-base font-bold text-white">
    <%= is_first_time ? "Set Master PIN" : "Unlock Vault" %>
  </h3>
  <p class="text-xs text-neutral-400 mt-1 max-w-xs mx-auto">
    <%= is_first_time ? "Choose a 4-to-6 digit PIN to protect your card numbers and PINs." : "Enter your PIN to reveal all card numbers and codes for 5 minutes." %>
  </p>

  <% if error_msg.present? %>
    <div class="mt-3 px-3 py-1.5 rounded-lg bg-rose-950/40 border border-rose-900/50 text-rose-300 text-xs font-medium">
      <%= error_msg %>
    </div>
  <% end %>

  <!-- Unlock Form -->
  <%= form_with url: unlock_path, method: :post, data: { pin_pad_target: "form", turbo: false }, class: "mt-4" do |f| %>
    <!-- Secret PIN Input -->
    <div class="relative flex justify-center mb-5">
      <%= f.password_field :pin, 
                           data: { pin_pad_target: "input", action: "input->pin-pad#onInput" }, 
                           class: "opacity-0 absolute inset-0 w-full h-full cursor-pointer z-10", 
                           autocomplete: "off", 
                           inputmode: "numeric", 
                           pattern: "[0-9]*", 
                           autofocus: true %>

      <!-- PIN Indicator Dots -->
      <div class="flex items-center justify-center gap-3">
        <div data-pin-pad-target="dot" class="w-3 h-3 rounded-full bg-neutral-700 transition-all duration-150"></div>
        <div data-pin-pad-target="dot" class="w-3 h-3 rounded-full bg-neutral-700 transition-all duration-150"></div>
        <div data-pin-pad-target="dot" class="w-3 h-3 rounded-full bg-neutral-700 transition-all duration-150"></div>
        <div data-pin-pad-target="dot" class="w-3 h-3 rounded-full bg-neutral-700 transition-all duration-150"></div>
      </div>
    </div>

    <!-- Mobile Tactile Numeric Keypad -->
    <div class="grid grid-cols-3 gap-2 max-w-[240px] mx-auto select-none">
      <% [1, 2, 3, 4, 5, 6, 7, 8, 9].each do |num| %>
        <button type="button" 
                data-action="click->pin-pad#pressDigit" 
                data-digit="<%= num %>" 
                class="h-12 rounded-xl bg-neutral-800 hover:bg-neutral-700 active:bg-neutral-600 font-semibold text-lg text-white border border-neutral-700/60 transition duration-100 flex items-center justify-center active:scale-95">
          <%= num %>
        </button>
      <% end %>

      <!-- Clear / Cancel -->
      <button type="button" 
              data-action="click->pin-pad#clear" 
              class="h-12 rounded-xl bg-neutral-800/40 hover:bg-neutral-800/80 font-medium text-xs text-neutral-400 active:scale-95 transition flex items-center justify-center">
        Clear
      </button>

      <!-- Digit 0 -->
      <button type="button" 
              data-action="click->pin-pad#pressDigit" 
              data-digit="0" 
              class="h-12 rounded-xl bg-neutral-800 hover:bg-neutral-700 active:bg-neutral-600 font-semibold text-lg text-white border border-neutral-700/60 transition duration-100 flex items-center justify-center active:scale-95">
        0
      </button>

      <!-- Backspace -->
      <button type="button" 
              data-action="click->pin-pad#backspace" 
              class="h-12 rounded-xl bg-neutral-800/40 hover:bg-neutral-800/80 font-medium text-neutral-400 active:scale-95 transition flex items-center justify-center" 
              title="Backspace">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414-6.414a2 2 0 011.414-.586H19a2 2 0 012 2v10a2 2 0 01-2 2h-8.172a2 2 0 01-1.414-.586L3 12z" />
        </svg>
      </button>
    </div>

    <!-- Manual Submit Button -->
    <div class="mt-4">
      <button type="submit" class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs active:scale-98 transition">
        <%= is_first_time ? "Save & Unlock (5 Min)" : "Unlock Vault" %>
      </button>
    </div>
  <% end %>
</div>
