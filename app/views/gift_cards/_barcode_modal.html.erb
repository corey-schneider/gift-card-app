<!-- Barcode Display Modal -->
<div id="barcode-modal" 
     data-barcode-modal-target="modal"
     class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-sm transition-all duration-200"
     onclick="if (event.target === this) window.closeVaultModal(this)">
  
  <div class="w-full max-w-sm bg-neutral-900 border border-neutral-800 text-neutral-100 rounded-2xl p-6 shadow-2xl relative text-center">
    <!-- Close Button -->
    <button type="button" 
            onclick="window.closeVaultModal(this)" 
            class="absolute top-4 right-4 p-2 text-neutral-400 hover:text-white rounded-lg bg-neutral-800/60 hover:bg-neutral-800 transition">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="mb-3">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-neutral-400">Scan at Register</span>
      <h3 data-barcode-modal-target="storeName" class="text-base font-bold text-white mt-0.5">Store</h3>
    </div>

    <!-- Scannable Barcode SVG Container (white background for optical scanners) -->
    <div class="py-4 px-3 bg-white rounded-xl shadow-sm flex flex-col items-center justify-center min-h-[120px]">
      <div data-barcode-modal-target="svgContainer" class="w-full"></div>
      <p data-barcode-modal-target="cardNumber" class="font-mono-code font-bold text-xs tracking-wider text-neutral-900 mt-2 select-all"></p>
    </div>

    <p class="text-[11px] text-neutral-400 mt-3">
      Present barcode to register or optical scanner.
    </p>

    <button type="button" 
            onclick="window.closeVaultModal(this)" 
            class="mt-4 w-full py-2.5 rounded-xl bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs transition">
      Done
    </button>
  </div>
</div>
