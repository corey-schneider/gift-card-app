<div id="<%= dom_id(gift_card) %>" class="relative rounded-2xl overflow-hidden border shadow-md transition-all duration-200 <%= gift_card.redeemed? ? 'opacity-60' : '' %>" style="border-color: <%= gift_card.finish_config[:border] %>">
  <!-- Brand-inspired Card Body -->
  <div class="p-5 text-neutral-100 flex flex-col justify-between min-h-[200px]" style="background: <%= gift_card.finish_config[:background] %>">
    
    <!-- Top Row: Store Name & Balance / Value -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2 mb-1">
          <span class="text-[10px] uppercase tracking-widest font-semibold text-neutral-400">
            <%= gift_card.has_balance? ? "Gift Card" : "Certificate / Voucher" %>
          </span>
          <% if gift_card.redeemed? %>
            <span class="px-2 py-0.5 text-[10px] font-semibold rounded-md bg-neutral-800 text-neutral-400 border border-neutral-700/60 uppercase">
              Redeemed
            </span>
          <% end %>
        </div>
        <div class="flex items-center gap-2 min-w-0">
          <% GiftCard.merchant_logo_assets(gift_card.store_name).each do |asset| %>
            <%= image_tag "/#{asset}", alt: "", loading: "lazy", class: "h-7 w-7 shrink-0 rounded-lg object-contain" %>
          <% end %>
          <h3 class="text-xl font-bold tracking-tight text-white truncate">
            <%= gift_card.store_name %>
          </h3>
        </div>
      </div>

      <!-- Right Column: Balance or Value Description -->
      <div class="text-right shrink-0">
        <% if gift_card.has_balance? %>
          <span class="text-[10px] uppercase tracking-wider text-neutral-400 block font-medium">Balance</span>
          <span class="text-2xl font-bold tracking-tight text-white">
            <%= number_to_currency(gift_card.balance, unit: "$") %>
          </span>
          <% if gift_card.value_description.present? %>
            <span class="text-[11px] text-neutral-400 block mt-0.5">
              <%= gift_card.value_description %>
            </span>
          <% end %>
        <% elsif gift_card.value_description.present? %>
          <span class="text-[10px] uppercase tracking-wider text-neutral-400 block font-medium">Perk / Value</span>
          <span class="text-base font-bold text-white max-w-[160px] truncate block">
            <%= gift_card.value_description %>
          </span>
        <% else %>
          <span class="text-[10px] uppercase tracking-wider text-neutral-400 block font-medium">Type</span>
          <span class="text-xs font-semibold text-neutral-300 px-2 py-0.5 rounded bg-neutral-800 border border-neutral-700/50 block mt-0.5">
            Certificate
          </span>
        <% end %>
      </div>
    </div>

    <!-- Middle: Expiration & Notes -->
    <div class="my-3 flex flex-wrap items-center gap-2">
      <% if gift_card.expiration_date.present? %>
        <% if gift_card.expired? %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-rose-950/40 text-rose-300 border border-rose-900/40">
            <svg class="w-3.5 h-3.5 text-rose-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            Expired <%= gift_card.expiration_date.strftime("%b %d, %Y") %>
          </span>
        <% elsif gift_card.expiring_soon? %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-amber-950/40 text-amber-200 border border-amber-800/40">
            <svg class="w-3.5 h-3.5 text-amber-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            Expiring soon (<%= pluralize(gift_card.days_remaining, "day") %>)
          </span>
        <% else %>
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-neutral-800/80 text-neutral-300 border border-neutral-700/50">
            <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            Expires <%= gift_card.expiration_date.strftime("%b %d, %Y") %>
          </span>
        <% end %>
      <% else %>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-medium bg-neutral-800/80 text-neutral-300 border border-neutral-700/50">
          <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
          </svg>
          No Expiration
        </span>
      <% end %>

      <% if gift_card.notes.present? %>
        <span class="text-xs text-neutral-400 truncate max-w-[220px]" title="<%= gift_card.notes %>">
          <%= gift_card.notes %>
        </span>
      <% end %>
    </div>

    <!-- Protected Info Box: Card Number & PIN -->
    <div class="mt-2 bg-black/40 rounded-xl p-3 border border-white/[0.06] flex flex-col gap-2">
      <div class="flex items-center justify-between gap-3">
        <!-- Number Column -->
        <div class="flex-1 min-w-0">
          <span class="text-[10px] uppercase font-semibold text-neutral-400 tracking-wider block">Card / Code Number</span>
          <% if session_unlocked? %>
            <div class="flex items-center gap-2 mt-0.5">
              <span class="font-mono-code text-sm font-semibold text-white tracking-wider select-all">
                <%= gift_card.card_number %>
              </span>
              <!-- Copy Number -->
              <div data-controller="clipboard" data-clipboard-text-value="<%= gift_card.clean_card_number %>">
                <button type="button" data-action="click->clipboard#copy" class="p-1 rounded bg-neutral-800 hover:bg-neutral-700 active:scale-95 transition text-neutral-300 hover:text-white" title="Copy Card Number">
                  <span data-clipboard-target="icon">
                    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                  </span>
                </button>
                <span data-clipboard-target="feedback" class="hidden absolute ml-2 -mt-7 bg-white text-neutral-950 font-semibold text-[10px] px-1.5 py-0.5 rounded shadow">Copied</span>
              </div>

              <!-- Barcode Button -->
              <button type="button" 
                      onclick="window.openVaultModal('barcode-modal')"
                      data-action="click->barcode-modal#show" 
                      data-store="<%= gift_card.store_name %>" 
                      data-number="<%= gift_card.clean_card_number %>"
                      class="p-1 rounded bg-neutral-800 hover:bg-neutral-700 active:scale-95 transition text-neutral-300 hover:text-white ml-auto" 
                      title="Show Barcode">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m-4-16v16m-4-16v16m12-16v16m4-16v16" />
                </svg>
              </button>
            </div>
          <% else %>
            <div class="flex items-center gap-2 mt-0.5">
              <span class="font-mono-code text-sm font-medium text-neutral-300 tracking-wider">
                <%= gift_card.masked_card_number %>
              </span>
              <button type="button" onclick="document.getElementById('unlock-modal-trigger').click()" class="inline-flex items-center gap-1 text-[11px] font-medium text-neutral-300 bg-neutral-800 hover:bg-neutral-700 px-2 py-0.5 rounded transition ml-auto border border-neutral-700/60">
                <svg class="w-3 h-3 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                Unlock
              </button>
            </div>
          <% end %>
        </div>

        <!-- PIN Column -->
        <div class="border-l border-neutral-800 pl-3 shrink-0">
          <span class="text-[10px] uppercase font-semibold text-neutral-400 tracking-wider block">PIN</span>
          <% if session_unlocked? %>
            <% if gift_card.pin.present? %>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span class="font-mono-code text-sm font-semibold text-white tracking-widest select-all">
                  <%= gift_card.pin %>
                </span>
                <div data-controller="clipboard" data-clipboard-text-value="<%= gift_card.pin %>">
                  <button type="button" data-action="click->clipboard#copy" class="p-1 rounded bg-neutral-800 hover:bg-neutral-700 active:scale-95 transition text-neutral-300 hover:text-white" title="Copy PIN">
                    <span data-clipboard-target="icon">
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                    </span>
                  </button>
                  <span data-clipboard-target="feedback" class="hidden absolute ml-2 -mt-7 bg-white text-neutral-950 font-semibold text-[10px] px-1.5 py-0.5 rounded shadow">Copied</span>
                </div>
              </div>
            <% else %>
              <span class="text-xs text-neutral-500 mt-0.5 block italic">None</span>
            <% end %>
          <% else %>
            <div class="flex items-center gap-1 mt-0.5">
              <span class="font-mono-code text-sm font-medium text-neutral-500 tracking-widest">
                <%= gift_card.masked_pin %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Card Action Footer -->
    <div class="mt-3 pt-3 border-t border-white/15 flex items-center justify-between text-xs text-neutral-300">
      <div class="flex items-center gap-2">
        <span class="text-[10px] text-neutral-400">Added <%= gift_card.created_at.strftime("%b %-d, %Y") %></span>
        <% if gift_card.booking_url.present? %>
          <a href="<%= gift_card.booking_url %>" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-medium text-neutral-300 hover:text-white underline decoration-neutral-600 hover:decoration-white transition">
            <span>Website</span>
            <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        <% end %>
      </div>

      <div class="flex items-center gap-2">
        <!-- Toggle Redeemed Status -->
        <%= button_to toggle_redeemed_gift_card_path(gift_card, status: params[:status], sort: params[:sort], q: params[:q]),
                      method: :patch,
                      class: "px-2.5 py-1 rounded-md text-[11px] font-medium transition active:scale-95 #{gift_card.redeemed? ? 'bg-neutral-800 text-neutral-200 hover:bg-neutral-700' : 'bg-neutral-850 hover:bg-neutral-800 text-neutral-300 border border-neutral-700/60'}",
                      title: gift_card.redeemed? ? "Mark active" : "Mark redeemed" do %>
          <%= gift_card.redeemed? ? "Mark Active" : "Mark Redeemed" %>
        <% end %>

        <!-- Edit Card Button -->
        <% if session_unlocked? %>
          <button type="button" 
                  onclick="window.openEditModal('<%= gift_card.id %>', '<%= j gift_card.store_name %>', '<%= j gift_card.card_number %>', '<%= j gift_card.pin %>', '<%= gift_card.balance %>', '<%= j gift_card.value_description %>', '<%= gift_card.currency %>', '<%= gift_card.expiration_date&.strftime('%Y-%m-%d') %>', '<%= j gift_card.booking_url %>', '<%= gift_card.redeemed %>', '<%= gift_card.color_theme %>', '<%= j gift_card.notes %>')"
                  class="p-1.5 rounded-md bg-neutral-800/80 hover:bg-neutral-700 text-neutral-300 hover:text-white transition"
                  title="Edit Card">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
          </button>
        <% else %>
          <button type="button" 
                  onclick="document.getElementById('unlock-modal-trigger').click()"
                  class="p-1.5 rounded-md bg-neutral-800/80 hover:bg-neutral-700 text-neutral-300 hover:text-white transition"
                  title="Unlock to Edit Card">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
            </svg>
          </button>
        <% end %>

        <!-- Delete Card Button -->
        <%= button_to gift_card_path(gift_card),
                      method: :delete,
                      data: { turbo_confirm: "Delete #{gift_card.store_name} card?" },
                      class: "p-1.5 rounded-md bg-neutral-800/80 hover:bg-rose-950/50 text-neutral-400 hover:text-rose-300 transition border border-neutral-700/60",
                      title: "Delete Card" do %>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
        <% end %>
      </div>
    </div>
  </div>
</div>
