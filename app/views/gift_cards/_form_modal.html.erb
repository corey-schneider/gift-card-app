<!-- Add / Edit Gift Card Modal -->
<div id="card-form-modal" 
     class="hidden fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/75 backdrop-blur-sm transition-all duration-200"
     onclick="if (event.target === this) window.closeVaultModal(this)">
  
  <div data-modal-target="content" 
       class="w-full max-w-md max-h-[90vh] bg-neutral-900 border-t sm:border border-neutral-800 rounded-t-2xl sm:rounded-2xl shadow-2xl overflow-y-auto transform transition-all duration-200 translate-y-full sm:translate-y-0 relative">
    
    <!-- Top Mobile Drag Handle -->
    <div class="sm:hidden pt-3 flex justify-center">
      <div class="w-10 h-1 rounded-full bg-neutral-700"></div>
    </div>

    <!-- Close Button -->
    <button type="button" 
            onclick="window.closeVaultModal(this)" 
            class="absolute top-4 right-4 p-2 text-neutral-400 hover:text-white rounded-lg bg-neutral-800/60 hover:bg-neutral-800 transition">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <div class="p-6">
      <div class="flex items-center gap-2 mb-4">
        <div class="w-7 h-7 rounded-lg bg-neutral-800 text-neutral-200 flex items-center justify-center border border-neutral-700">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
          </svg>
        </div>
        <h3 id="card-modal-title" class="text-base font-bold text-white">Add Gift Card</h3>
      </div>

      <!-- Form (dynamically switched between POST /gift_cards and PATCH /gift_cards/:id) -->
      <form id="card-active-form" action="<%= gift_cards_path %>" method="post" class="space-y-3.5">
        <%= token_tag %>
        <input type="hidden" name="_method" id="card-form-method" value="post">

        <!-- Store Name -->
        <div data-merchant-suggestions-url="<%= merchant_suggestions_gift_cards_path %>"
             data-known-merchants="<%= GiftCard::MERCHANT_NAMES.to_json %>">
          <label class="block text-xs font-semibold text-neutral-300 mb-1">Store / Merchant Name *</label>
          <div class="relative">
            <input type="text" name="gift_card[store_name]" id="card_store_name" required autocomplete="off" aria-autocomplete="list" aria-controls="merchant-suggestions" aria-expanded="false" placeholder="e.g. Target, Amazon, Skydiving Center, Starbucks" class="w-full px-3 py-2 rounded-xl bg-neutral-800 border border-neutral-700 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 text-xs text-white placeholder-neutral-500 outline-none transition">
            <ul id="merchant-suggestions" role="listbox" style="z-index: 50" class="hidden absolute left-0 right-0 mt-1 max-h-48 overflow-y-auto rounded-xl border border-neutral-700 bg-neutral-900 p-1 shadow-xl"></ul>
          </div>
          <!-- Quick Store Chips -->
          <div class="flex flex-wrap gap-1.5 mt-1.5">
            <% ["Amazon", "Target", "Starbucks", "Apple", "Best Buy", "Delta", "Airbnb"].each do |store| %>
              <button type="button" onclick="document.getElementById('card_store_name').value='<%= store %>'" class="px-2 py-0.5 rounded text-[10px] bg-neutral-800 text-neutral-400 hover:text-white hover:bg-neutral-700 border border-neutral-700/60 transition">
                <%= store %>
              </button>
            <% end %>
          </div>
        </div>

        <!-- Balance & Value Description Row -->
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-neutral-300 mb-1">
              Balance ($)
              <span class="text-[10px] text-neutral-500 font-normal">(optional)</span>
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center text-neutral-500 text-xs font-medium">$</span>
              <input type="number" step="0.01" min="0" name="gift_card[balance]" id="card_balance" placeholder="0.00" class="w-full pl-6 pr-3 py-2 rounded-xl bg-neutral-800 border border-neutral-700 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 text-xs text-white placeholder-neutral-500 outline-none transition">
            </div>
          </div>

          <div>
            <label class="block text-xs font-semibold text-neutral-300 mb-1">Color palette</label>
            <select name="gift_card[color_theme]" id="card_color_theme" class="w-full px-2.5 py-2 rounded-xl bg-neutral-800 border border-neutral-700 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 text-xs text-white outline-none transition">
              <option value="auto">Brand colors — automatic</option>
              <option value="evergreen">Evergreen</option>
              <option value="ocean">Ocean blue</option>
              <option value="ruby">Ruby red</option>
              <option value="violet">Violet</option>
              <option value="rose">Rose</option>
              <option value="teal">Teal</option>
              <option value="gold">Gold</option>
              <option value="classic">Charcoal</option>
            </select>
          </div>
        </div>

        <!-- Value / Offer Description -->
        <div>
          <label class="block text-xs font-semibold text-neutral-300 mb-1">
            Offer / Perk Description
            <span class="text-[10px] text-neutral-500 font-normal">(e.g. for vouchers, deals)</span>
          </label>
          <input type="text" name="gift_card[value_description]" id="card_value_description" placeholder="e.g. Buy 1 Get 1 Free, Valued at $125, 60-min Massage" class="w-full px-3 py-2 rounded-xl bg-neutral-800 border border-neutral-700 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 text-xs text-white placeholder-neutral-500 outline-none transition">
        </div>

        <!-- Card Number & PIN -->
        <div class="grid grid-cols-3 gap-3">
          <div class="col-span-2">
            <label class="block text-xs font-semibold text-neutral-300 mb-1">Card / Certificate Number *</label>
            <input type="text" name="gift_card[card_number]" id="card_card_number" required autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="XXXX XXXX XXXX" class="w-full px-3 py-2 rounded-xl bg-neutral-800 border border-neutral-700 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 font-mono-code text-xs text-white placeholder-neutral-500 outline-none transition">
          </div>

          <div>
            <label class="block text-xs font-semibold text-neutral-300 mb-1">PIN (optional)</label>
            <input type="text" name="gift_card[pin]" id="card_pin" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="PIN" class="w-full px-3 py-2 rounded-xl bg-neutral-800 border border-neutral-700 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 font-mono-code text-xs text-white placeholder-neutral-500 outline-none transition">
          </div>
        </div>

        <!-- Expiration Date with Presets -->
        <div>
          <div class="flex items-center justify-between mb-1">
            <label class="text-xs font-semibold text-neutral-300">Expiration Date (optional)</label>
            <div class="flex gap-1.5 text-[10px]">
              <button type="button" onclick="setExpirationYears(1)" class="text-neutral-400 hover:text-white hover:underline">+1 Yr</button>
              <span class="text-neutral-600">•</span>
              <button type="button" onclick="setExpirationYears(2)" class="text-neutral-400 hover:text-white hover:underline">+2 Yrs</button>
              <span class="text-neutral-600">•</span>
              <button type="button" onclick="document.getElementById('card_expiration_date').value=''" class="text-neutral-500 hover:text-white hover:underline">Never</button>
            </div>
          </div>
          <input type="date" name="gift_card[expiration_date]" id="card_expiration_date" class="w-full px-3 py-2 rounded-xl bg-neutral-800 border border-neutral-700 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 text-xs text-white outline-none transition">
        </div>

        <!-- Booking / Redeem URL -->
        <div>
          <label class="block text-xs font-semibold text-neutral-300 mb-1">Redeem / Booking URL (optional)</label>
          <input type="url" name="gift_card[booking_url]" id="card_booking_url" placeholder="https://..." class="w-full px-3 py-2 rounded-xl bg-neutral-800 border border-neutral-700 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 text-xs text-white placeholder-neutral-500 outline-none transition">
        </div>

        <!-- Notes / Memo -->
        <div>
          <label class="block text-xs font-semibold text-neutral-300 mb-1">Notes / Terms (optional)</label>
          <textarea name="gift_card[notes]" id="card_notes" rows="2" placeholder="e.g. Must call in advance to book, code valid for 2 participants" class="w-full px-3 py-1.5 rounded-xl bg-neutral-800 border border-neutral-700 focus:border-neutral-500 focus:ring-1 focus:ring-neutral-500 text-xs text-white placeholder-neutral-500 outline-none transition resize-none"></textarea>
        </div>

        <!-- Submit Button -->
        <div class="pt-2">
          <button type="submit" id="card-modal-submit" class="w-full py-2.5 px-4 rounded-xl bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs active:scale-98 transition flex items-center justify-center gap-2">
            Save Item
          </button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  window.openVaultModal = function(id) {
    const modal = document.getElementById(id);
    if (!modal) throw new Error(`Modal #${id} was not found`);

    if (!window.vaultScrollState) {
      const scrollY = window.scrollY;
      window.vaultScrollState = {
        scrollY,
        bodyStyles: {
          position: document.body.style.position,
          top: document.body.style.top,
          left: document.body.style.left,
          right: document.body.style.right,
          width: document.body.style.width
        },
        documentOverflow: document.documentElement.style.overflow
      };
      document.body.style.position = 'fixed';
      document.body.style.top = `-${scrollY}px`;
      document.body.style.left = '0';
      document.body.style.right = '0';
      document.body.style.width = '100%';
      document.documentElement.style.overflow = 'hidden';
    }

    modal.classList.remove('hidden');
    const content = modal.querySelector('[data-modal-target="content"]');
    content?.classList.remove('translate-y-full', 'scale-95', 'opacity-0');
    content?.classList.add('translate-y-0', 'scale-100', 'opacity-100');
    document.body.classList.add('overflow-hidden');
    if (id === 'card-form-modal') window.initializeMerchantAutocomplete();
  };

  window.closeVaultModal = function(target) {
    const modal = target instanceof Element ? target.closest('.fixed.inset-0') : document.getElementById(target);
    if (!modal || modal.classList.contains('hidden')) return;

    const content = modal.querySelector('[data-modal-target="content"]');
    content?.classList.add('translate-y-full', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
      if (document.querySelector('.fixed.inset-0:not(.hidden)')) return;

      const state = window.vaultScrollState;
      if (!state) return;
      Object.assign(document.body.style, state.bodyStyles);
      document.documentElement.style.overflow = state.documentOverflow;
      document.body.classList.remove('overflow-hidden');
      window.vaultScrollState = null;
      window.scrollTo(0, state.scrollY);
    }, 200);
  };

  if (!window.vaultModalHandlersInstalled) {
    document.addEventListener('keydown', event => {
      if (event.key !== 'Escape') return;
      const modal = [...document.querySelectorAll('.fixed.inset-0:not(.hidden)')].pop();
      if (modal) window.closeVaultModal(modal);
    });
    window.vaultModalHandlersInstalled = true;
  }

  window.initializeMerchantAutocomplete = function() {
    const input = document.getElementById('card_store_name');
    const wrapper = input?.closest('[data-known-merchants]');
    const suggestions = document.getElementById('merchant-suggestions');
    if (!input || !wrapper || !suggestions || input.dataset.autocompleteReady) return;

    input.dataset.autocompleteReady = 'true';
    const normalize = value => value.toLowerCase().replace(/[^a-z0-9]/g, '');
    let activeIndex = -1;
    let requestController;
    let searchTimeout;

    const hide = () => {
      suggestions.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activeIndex = -1;
    };

    const render = names => {
      const matches = [...new Map(names.map(name => [normalize(name), name])).values()].slice(0, 10);
      suggestions.replaceChildren(...matches.map((name, index) => {
        const option = document.createElement('li');
        option.id = `merchant-suggestion-${index}`;
        option.dataset.name = name;
        option.setAttribute('role', 'option');
        option.setAttribute('aria-selected', 'false');
        option.className = 'cursor-pointer rounded-lg px-3 py-2 text-xs text-neutral-200 hover:bg-neutral-800';
        option.textContent = name;
        option.addEventListener('pointerdown', event => {
          event.preventDefault();
          input.value = name;
          hide();
          input.focus();
        });
        return option;
      }));
      suggestions.classList.toggle('hidden', matches.length === 0);
      input.setAttribute('aria-expanded', String(matches.length > 0));
      activeIndex = -1;
    };

    input.addEventListener('input', () => {
      clearTimeout(searchTimeout);
      requestController?.abort();

      const query = normalize(input.value);
      if (!query) {
        render([]);
        return;
      }

      const known = JSON.parse(wrapper.dataset.knownMerchants);
      render(known.filter(name => normalize(name).startsWith(query)));
      searchTimeout = setTimeout(async () => {
        requestController = new AbortController();
        const url = new URL(wrapper.dataset.merchantSuggestionsUrl, window.location.origin);
        url.searchParams.set('q', input.value);
        try {
          const response = await fetch(url, {
            headers: { Accept: 'application/json' },
            signal: requestController.signal
          });
          if (!response.ok) throw new Error(`Merchant suggestions failed: ${response.status}`);
          const stored = await response.json();
          if (normalize(input.value) === query) {
            render([...known.filter(name => normalize(name).startsWith(query)), ...stored]);
          }
        } catch (error) {
          if (error.name !== 'AbortError') console.error(error);
        }
      }, 100);
    });

    input.addEventListener('keydown', event => {
      const options = suggestions.querySelectorAll('[role="option"]');
      if (!options.length) return;
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        activeIndex = (activeIndex + (event.key === 'ArrowDown' ? 1 : -1) + options.length) % options.length;
        options.forEach((option, index) => {
          const active = index === activeIndex;
          option.setAttribute('aria-selected', String(active));
          option.classList.toggle('bg-neutral-800', active);
        });
        input.setAttribute('aria-activedescendant', options[activeIndex].id);
      } else if (event.key === 'Enter' && activeIndex >= 0) {
        event.preventDefault();
        input.value = options[activeIndex].dataset.name;
        hide();
      } else if (event.key === 'Escape') {
        hide();
      }
    });

    input.addEventListener('blur', () => setTimeout(() => {
      if (!wrapper.contains(document.activeElement)) hide();
    }, 0));
  };

  function setExpirationYears(years) {
    const d = new Date();
    d.setFullYear(d.getFullYear() + years);
    const yyyy = d.getFullYear();
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const dd = String(d.getDate()).padStart(2, '0');
    document.getElementById('card_expiration_date').value = `${yyyy}-${mm}-${dd}`;
  }

  window.openAddModal = function() {
    const form = document.getElementById('card-active-form');
    const methodInput = document.getElementById('card-form-method');
    const title = document.getElementById('card-modal-title');
    const submit = document.getElementById('card-modal-submit');

    form.action = "<%= gift_cards_path %>";
    methodInput.value = "post";
    title.textContent = "Add Gift Card or Voucher";
    submit.textContent = "Save Item";

    document.getElementById('card_store_name').value = '';
    document.getElementById('card_card_number').value = '';
    document.getElementById('card_pin').value = '';
    document.getElementById('card_balance').value = '';
    document.getElementById('card_value_description').value = '';
    document.getElementById('card_color_theme').value = 'auto';
    document.getElementById('card_expiration_date').value = '';
    document.getElementById('card_booking_url').value = '';
    document.getElementById('card_notes').value = '';

    window.openVaultModal('card-form-modal');
    setTimeout(() => {
      document.getElementById('card_store_name').focus();
    }, 100);
  };

  window.openEditModal = function(id, store, number, pin, balance, value_desc, currency, exp, booking, redeemed, theme, notes) {
    const form = document.getElementById('card-active-form');
    const methodInput = document.getElementById('card-form-method');
    const title = document.getElementById('card-modal-title');
    const submit = document.getElementById('card-modal-submit');

    form.action = `/gift_cards/${id}`;
    methodInput.value = "patch";
    title.textContent = `Edit ${store}`;
    submit.textContent = "Update Item";

    document.getElementById('card_store_name').value = store || '';
    document.getElementById('card_card_number').value = number || '';
    document.getElementById('card_pin').value = pin || '';
    document.getElementById('card_balance').value = (balance && balance !== "null" && balance !== "0.0") ? balance : '';
    document.getElementById('card_value_description').value = value_desc || '';
    const legacyThemes = { emerald: 'evergreen', forest: 'evergreen', navy: 'ocean', stone: 'classic', zinc: 'classic', amber: 'gold' };
    document.getElementById('card_color_theme').value = legacyThemes[theme] || theme || 'auto';
    document.getElementById('card_expiration_date').value = exp || '';
    document.getElementById('card_booking_url').value = booking || '';
    document.getElementById('card_notes').value = notes || '';

    window.openVaultModal('card-form-modal');
  };
</script>
