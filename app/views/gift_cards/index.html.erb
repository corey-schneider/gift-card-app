<div id="app-content" data-controller="barcode-modal" class="flex-1 flex flex-col">
  <!-- Top Clean Navigation Bar -->
  <header class="sticky top-0 z-40 bg-[#0d0f12]/90 backdrop-blur-md border-b border-neutral-800/80 px-4 pt-safe pb-3">
    <div class="flex items-center justify-between gap-3">
      <!-- App Brand -->
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-neutral-800 border border-neutral-700 flex items-center justify-center text-neutral-200">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
          </svg>
        </div>
        <div>
          <h1 class="text-sm font-bold tracking-tight text-white flex items-center gap-1.5">
            VaultCards
          </h1>
          <span class="text-[10px] text-neutral-400 block font-medium -mt-0.5">Card & Voucher Registry</span>
        </div>
      </div>

      <!-- Header Actions: Lock/Unlock Pill & Settings -->
      <div class="flex items-center gap-2">
        <% if session_unlocked? %>
          <!-- Clean Countdown Unlock Pill -->
          <div data-controller="unlock-timer" 
               data-unlock-timer-seconds-value="<%= remaining_unlock_seconds %>" 
               class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-neutral-900 border border-neutral-700 text-neutral-200 text-xs font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            <span data-unlock-timer-target="display" class="font-mono-code text-[11px]">05:00</span>
            
            <%= button_to lock_path, method: :delete, class: "ml-1 text-neutral-400 hover:text-white transition", title: "Lock Now" do %>
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            <% end %>
          </div>
        <% else %>
          <!-- Locked Pill -->
          <button type="button" 
                  id="unlock-modal-trigger" 
                  onclick="window.openVaultModal('unlock-modal')"
                  class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-neutral-900 hover:bg-neutral-800 border border-neutral-700 text-neutral-300 text-xs font-medium transition active:scale-95">
            <svg class="w-3.5 h-3.5 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <span>Locked</span>
          </button>
        <% end %>

        <!-- Settings Modal Trigger -->
        <button type="button" 
                onclick="window.openVaultModal('settings-modal')"
                class="p-1.5 rounded-lg bg-neutral-900 hover:bg-neutral-800 border border-neutral-800 text-neutral-400 hover:text-white transition active:scale-95"
                title="Security Settings">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main class="flex-1 px-4 py-4 space-y-4">
    <!-- Clean Portfolio Summary Card -->
    <div class="rounded-2xl bg-neutral-900/90 p-5 border border-neutral-800 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <span class="text-[10px] uppercase tracking-wider text-neutral-400 font-semibold block">Active Balance</span>
          <div class="text-3xl font-extrabold tracking-tight text-white mt-0.5">
            <%= number_to_currency(@total_active_balance, unit: "$") %>
          </div>
          <div class="flex flex-wrap items-center gap-2 mt-2">
            <span class="inline-flex items-center gap-1 text-xs text-neutral-400">
              <%= pluralize(@active_count, "active item") %>
              <% if @voucher_count > 0 %>
                (<%= pluralize(@voucher_count, "certificate") %>)
              <% end %>
            </span>
            <% if @expiring_soon_count > 0 %>
              <span class="text-neutral-500">•</span>
              <span class="inline-flex items-center gap-1 text-xs text-amber-300/90">
                <%= pluralize(@expiring_soon_count, "expiring soon") %>
              </span>
            <% end %>
          </div>
        </div>

        <!-- Add Card Button -->
        <button type="button" 
                onclick="window.openAddModal()" 
                class="shrink-0 inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs transition active:scale-95 shadow-sm">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
          </svg>
          <span>Add Card</span>
        </button>
      </div>
    </div>

    <!-- Filter & Sort Bar -->
    <div class="space-y-2.5">
      <!-- Search Box & Sort Form -->
      <%= form_with url: root_path, method: :get, class: "space-y-2" do |f| %>
        <%= f.hidden_field :status, value: @current_status %>

        <!-- Search Input -->
        <div class="relative">
          <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-neutral-500">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </span>
          <%= f.text_field :q, 
                           value: @search_query, 
                           placeholder: "Search cards, perks, or notes...", 
                           onchange: "this.form.submit()",
                           class: "w-full pl-10 pr-9 py-2 rounded-xl bg-neutral-900 border border-neutral-800 text-xs text-white placeholder-neutral-500 focus:outline-none focus:border-neutral-600 transition" %>
          <% if @search_query.present? %>
            <a href="<%= root_path(status: @current_status, sort: @current_sort) %>" class="absolute inset-y-0 right-0 pr-3 flex items-center text-neutral-500 hover:text-white">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </a>
          <% end %>
        </div>

        <!-- Filter Tabs & Sort Picker Row -->
        <div class="flex items-center justify-between gap-2">
          <!-- Status Segmented Pills -->
          <div class="inline-flex rounded-lg bg-neutral-900 p-0.5 border border-neutral-800 text-xs font-medium">
            <%= link_to "Active (#{@active_count})", root_path(status: "active", sort: @current_sort, q: @search_query),
                        class: "px-2.5 py-1 rounded-md transition #{ @current_status == 'active' ? 'bg-neutral-800 text-white shadow-sm' : 'text-neutral-400 hover:text-neutral-200' }" %>
            <%= link_to "Redeemed", root_path(status: "redeemed", sort: @current_sort, q: @search_query),
                        class: "px-2.5 py-1 rounded-md transition #{ @current_status == 'redeemed' ? 'bg-neutral-800 text-white shadow-sm' : 'text-neutral-400 hover:text-neutral-200' }" %>
            <%= link_to "All", root_path(status: "all", sort: @current_sort, q: @search_query),
                        class: "px-2.5 py-1 rounded-md transition #{ @current_status == 'all' ? 'bg-neutral-800 text-white shadow-sm' : 'text-neutral-400 hover:text-neutral-200' }" %>
          </div>

          <!-- Sort Select -->
          <div class="relative shrink-0">
            <select name="sort" onchange="this.form.submit()" class="appearance-none pl-2.5 pr-7 py-1 rounded-lg bg-neutral-900 border border-neutral-800 text-xs text-neutral-300 focus:outline-none focus:border-neutral-600 transition cursor-pointer">
              <option value="expiring_first" <%= 'selected' if @current_sort == 'expiring_first' %>>Expiring first</option>
              <option value="exp_asc" <%= 'selected' if @current_sort == 'exp_asc' %>>Expiration: soonest</option>
              <option value="exp_desc" <%= 'selected' if @current_sort == 'exp_desc' %>>Expiration: furthest</option>
              <option value="name_asc" <%= 'selected' if @current_sort == 'name_asc' %>>Store: A → Z</option>
              <option value="name_desc" <%= 'selected' if @current_sort == 'name_desc' %>>Store: Z → A</option>
              <option value="amount_desc" <%= 'selected' if @current_sort == 'amount_desc' %>>Balance: High → Low</option>
              <option value="amount_asc" <%= 'selected' if @current_sort == 'amount_asc' %>>Balance: Low → High</option>
            </select>
            <span class="absolute inset-y-0 right-0 pr-2 flex items-center pointer-events-none text-neutral-500">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </div>
        </div>
      <% end %>
    </div>

    <!-- Gift Cards List -->
    <div id="gift-cards-container" class="space-y-3.5">
      <% if @gift_cards.any? %>
        <% @gift_cards.each do |card| %>
          <%= render "gift_cards/gift_card", gift_card: card %>
        <% end %>
      <% else %>
        <!-- Empty State -->
        <div class="rounded-2xl border border-dashed border-neutral-800 p-8 text-center bg-neutral-900/40 my-6">
          <div class="mx-auto w-10 h-10 rounded-lg bg-neutral-800 flex items-center justify-center text-neutral-400 mb-3">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
            </svg>
          </div>
          <h4 class="text-sm font-semibold text-white">No items found</h4>
          <p class="text-xs text-neutral-400 mt-1 max-w-xs mx-auto">
            <%= @search_query.present? ? "No cards match '#{@search_query}'." : "Your vault is empty. Tap below to store your first gift card or certificate." %>
          </p>
          <div class="mt-4">
            <button type="button" 
                    onclick="window.openAddModal()" 
                    class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs transition active:scale-95 shadow-sm">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
              </svg>
              <span>Add Gift Card</span>
            </button>
          </div>
        </div>
      <% end %>
    </div>
  </main>

  <!-- Modals -->
  <%= render "unlocks/modal" %>
  <%= render "gift_cards/form_modal" %>
  <%= render "gift_cards/barcode_modal" %>
  <%= render "unlocks/settings_modal" %>
</div>
