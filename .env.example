# VaultCards Environment Configuration Example
# Copy to .env for local environment overrides (never commit .env to version control)

# Rails Master Key (optional if mounting config/master.key in docker-compose.yml)
# RAILS_MASTER_KEY=your_rails_master_key_here

# Host port mapping (default: 3000)
PORT=3000

# Optional: Master unlock PIN (if omitted, set your PIN in the app on first launch)
# APP_UNLOCK_PIN=
